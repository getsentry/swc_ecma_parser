 src/error.rs       |  5 +++++
 src/parser/expr.rs | 18 ++++++++++++++++++
 src/parser/mod.rs  | 40 ++++++++++++++++++++++++++++++++++++++++
 src/parser/stmt.rs | 11 +++++++++++
 4 files changed, 74 insertions(+)

diff --git a/src/error.rs b/src/error.rs
index 20c4ec9..0ee480b 100644
--- a/src/error.rs
+++ b/src/error.rs
@@ -41,6 +41,9 @@ impl Error {
 #[non_exhaustive]
 pub enum SyntaxError {
     Eof,
+
+    /// SENTRY PATCH: see README.md.
+    TooMuchRecursion,
     DeclNotAllowed,
 
     UsingDeclNotAllowed,
@@ -298,6 +301,8 @@ impl SyntaxError {
     #[inline(never)]
     pub fn msg(&self) -> Cow<'static, str> {
         match self {
+            // SENTRY PATCH: see README.md.
+            SyntaxError::TooMuchRecursion => "expression nesting is too deep".into(),
             SyntaxError::PrivateNameInInterface => {
                 "private names are not allowed in interface".into()
             }
diff --git a/src/parser/expr.rs b/src/parser/expr.rs
index 9ad64f6..3fd355d 100644
--- a/src/parser/expr.rs
+++ b/src/parser/expr.rs
@@ -72,6 +72,12 @@ impl<I: Tokens> Parser<I> {
         tracing::instrument(level = "debug", skip_all)
     )]
     pub(crate) fn parse_assignment_expr(&mut self) -> PResult<Box<Expr>> {
+        // SENTRY PATCH: see README.md. One level of the expression
+        // recursion, bounded and stack-grown.
+        self.with_recursion_guard(|p| p.parse_assignment_expr_inner())
+    }
+
+    fn parse_assignment_expr_inner(&mut self) -> PResult<Box<Expr>> {
         trace_cur!(self, parse_assignment_expr);
 
         if self.input().syntax().typescript() && self.input().is(Token::JSXTagStart) {
@@ -166,6 +172,12 @@ impl<I: Tokens> Parser<I> {
     }
 
     pub(super) fn parse_unary_expr(&mut self) -> PResult<Box<Expr>> {
+        // SENTRY PATCH: see README.md. One level of the expression
+        // recursion, bounded and stack-grown.
+        self.with_recursion_guard(|p| p.parse_unary_expr_inner())
+    }
+
+    fn parse_unary_expr_inner(&mut self) -> PResult<Box<Expr>> {
         trace_cur!(self, parse_unary_expr);
 
         let token_and_span = self.input().get_cur();
@@ -1515,6 +1527,12 @@ impl<I: Tokens> Parser<I> {
     }
 
     fn parse_member_expr_or_new_expr_inner(&mut self, is_new_expr: bool) -> PResult<Box<Expr>> {
+        // SENTRY PATCH: see README.md. One level of the expression
+        // recursion, bounded and stack-grown.
+        self.with_recursion_guard(|p| p.parse_member_expr_or_new_expr_innermost(is_new_expr))
+    }
+
+    fn parse_member_expr_or_new_expr_innermost(&mut self, is_new_expr: bool) -> PResult<Box<Expr>> {
         trace_cur!(self, parse_member_expr_or_new_expr);
 
         let start = self.cur_pos();
diff --git a/src/parser/mod.rs b/src/parser/mod.rs
index bd2e347..f18720a 100644
--- a/src/parser/mod.rs
+++ b/src/parser/mod.rs
@@ -60,8 +60,25 @@ pub struct Parser<I: self::input::Tokens> {
     state: State,
     input: self::input::Buffer<I>,
     found_module_item: bool,
+    /// SENTRY PATCH: see README.md. Depth of the expression recursion
+    /// currently in progress.
+    recursion_depth: usize,
 }
 
+/// SENTRY PATCH: see README.md.
+///
+/// The deepest nesting the parser will accept before reporting
+/// [`SyntaxError::TooMuchRecursion`].
+///
+/// The expression and statement grammars are mutually recursive and their
+/// depth is driven entirely by the input, so without a limit a few kilobytes
+/// of hostile source can drive the parser to any depth at all.
+///
+/// Real-world sources come nowhere near this. Across the JavaScript fixtures
+/// in getsentry/symbolic the deepest is jquery.js at 54, with jquery.min.js
+/// at 52 and a Metro bundle at 38, leaving roughly 38x headroom here.
+pub const MAX_RECURSION_DEPTH: usize = 2048;
+
 impl<I: Tokens> Parser<I> {
     #[inline(always)]
     pub fn input(&self) -> &Buffer<I> {
@@ -103,6 +120,28 @@ impl<I: Tokens> Parser<I> {
     fn mark_found_module_item(&mut self) {
         self.found_module_item = true;
     }
+
+    /// SENTRY PATCH: see README.md.
+    ///
+    /// Runs one level of the expression recursion, refusing to descend past
+    /// [`MAX_RECURSION_DEPTH`] and growing the stack when it runs low.
+    ///
+    /// The depth limit is what bounds the work: `maybe_grow` alone would turn
+    /// a stack overflow into unbounded heap growth, since it moves the stack
+    /// onto fresh heap segments rather than capping it. Reporting a syntax
+    /// error instead lets the caller recover, which a stack overflow (an
+    /// abort, not an unwind) never allows.
+    fn with_recursion_guard<T>(&mut self, f: impl FnOnce(&mut Self) -> PResult<T>) -> PResult<T> {
+        if self.recursion_depth >= MAX_RECURSION_DEPTH {
+            syntax_error!(self, SyntaxError::TooMuchRecursion)
+        }
+
+        self.recursion_depth += 1;
+        let result = crate::maybe_grow(256 * 1024, 1024 * 1024, || f(self));
+        self.recursion_depth -= 1;
+
+        result
+    }
 }
 
 impl<'a> Parser<crate::lexer::Lexer<'a>> {
@@ -123,6 +162,7 @@ impl<I: Tokens> Parser<I> {
             state: Default::default(),
             input: crate::parser::input::Buffer::new(input),
             found_module_item: false,
+            recursion_depth: 0,
         };
         p.input.bump(); // consume EOF
         p
diff --git a/src/parser/stmt.rs b/src/parser/stmt.rs
index 634c616..27309d6 100644
--- a/src/parser/stmt.rs
+++ b/src/parser/stmt.rs
@@ -1023,6 +1023,17 @@ impl<I: Tokens> Parser<I> {
         start: BytePos,
         include_decl: bool,
         decorators: Vec<Decorator>,
+    ) -> PResult<Stmt> {
+        // SENTRY PATCH: see README.md. Statement nesting recurses too
+        // (nested blocks, nested function bodies), so it shares the budget.
+        self.with_recursion_guard(|p| p.parse_stmt_internal_inner(start, include_decl, decorators))
+    }
+
+    fn parse_stmt_internal_inner(
+        &mut self,
+        start: BytePos,
+        include_decl: bool,
+        decorators: Vec<Decorator>,
     ) -> PResult<Stmt> {
         trace_cur!(self, parse_stmt_internal);
 
